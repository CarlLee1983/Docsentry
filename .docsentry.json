{
  "$schema": "./schema.json",
  "documents": [
    "README.md",
    "SPEC.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CONTEXT.md",
    "docs/**/*.md"
  ],
  "package": {
    "manifest": "package.json",
    "assertions": [
      {
        "document": "README.md",
        "label": "published package name",
        "value": "@carllee1983/docsentry",
        "evidence": "/name"
      }
    ]
  },
  "schemaExamples": [
    {
      "documents": [
        "README.md"
      ],
      "language": "json",
      "schema": "schema.json"
    }
  ],
  "actionExamples": [
    {
      "documents": [
        "README.md"
      ],
      "action": "action.yml",
      "uses": "CarlLee1983/Docsentry"
    }
  ],
  "pathReferences": [
    {
      "documents": [
        "README.md",
        "SPEC.md",
        "ARCHITECTURE.md",
        "ROADMAP.md",
        "AGENTS.md",
        "CONTEXT.md",
        "docs/**/*.md"
      ],
      "include": [
        "src/**",
        "test/**",
        "docs/**",
        "examples/**",
        ".github/**",
        "*.json",
        "*.yml",
        "*.md"
      ],
      "exclude": [
        ".docsentry-baseline.json"
      ]
    }
  ],
  "versionReferences": [
    {
      "documents": [
        "README.md"
      ],
      "pattern": "CarlLee1983/Docsentry@v{version}",
      "label": "documented Action reference",
      "required": true
    }
  ],
  "directoryTrees": [
    {
      "documents": [
        "ARCHITECTURE.md"
      ],
      "fenceLabel": "source-layout",
      "root": "src",
      "mode": "exact"
    }
  ],
  "enumerations": [
    {
      "documents": [
        "SPEC.md"
      ],
      "label": "domain term",
      "values": {
        "sources": [
          "CONTEXT.md"
        ],
        "pattern": "\\*\\*([A-Z][a-z]+(?: [a-z]+)?)\\*\\*:"
      },
      "documented": {
        "pattern": "[A-Z][a-z]+(?: [a-z]+)?",
        "section": "Ubiquitous language"
      }
    },
    {
      "documents": [
        "SPEC.md"
      ],
      "label": "rule identifier",
      "values": {
        "sources": [
          "src/core/rules/*.ts"
        ],
        "pattern": "\"(DOC_[A-Z_]+)\""
      },
      "documented": {
        "pattern": "DOC_[A-Z_]+",
        "section": "Rule identifiers"
      }
    }
  ]
}
