{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@carllee1983/docsentry/schema.json",
  "title": "Docsentry configuration",
  "description": "Configuration for deterministic documentation verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "The JSON Schema used by editors for this configuration file."
    },
    "documents": {
      "$ref": "#/$defs/documentPatterns",
      "description": "Markdown paths or glob patterns selected for the default check."
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "schemaExamples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schemaExample"
      }
    },
    "actionExamples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionExample"
      }
    },
    "documentPairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentPair"
      }
    },
    "versionReferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionReference"
      }
    },
    "pathReferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathReference"
      }
    },
    "directoryTrees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directoryTree"
      }
    },
    "enumerations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enumeration"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "documentPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "package.json"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document", "label", "value", "evidence"],
            "properties": {
              "document": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "value": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "evidence": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    "schemaExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "language", "schema"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "language": {
          "enum": ["json", "yaml", "yml"]
        },
        "schema": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fenceLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$",
          "description": "Optional whitespace-separated Markdown fence metadata label required on examples selected by this schema."
        }
      }
    },
    "actionExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "action"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "action": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "uses": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional GitHub Action reference to select from workflow examples. Its @ref suffix is ignored when matching."
        }
      }
    },
    "versionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "pattern"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\{version\\}",
          "description": "Literal text surrounding one or more {version} placeholders, such as CarlLee1983/Docsentry@v{version}."
        },
        "manifest": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "package.json",
          "description": "JSON manifest holding the version evidence."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "default": "/version",
          "description": "JSON pointer to the authoritative version value in the manifest."
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-readable name for this reference, used in finding messages."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Report a finding when a selected document never states the pattern."
        }
      }
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "include"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "include": {
          "$ref": "#/$defs/documentPatterns",
          "description": "Repository-relative glob patterns selecting which inline code spans are treated as paths."
        },
        "exclude": {
          "$ref": "#/$defs/documentPatterns",
          "description": "Glob patterns removed from the selection, for filenames a document names as a convention rather than a file."
        }
      }
    },
    "enumeration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "label", "values", "documented"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Name of the enumerated thing, used in finding messages."
        },
        "values": {
          "description": "Where the defined values come from: matched source text, or one pointer into a structured manifest.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sources", "pattern"],
              "properties": {
                "sources": {
                  "$ref": "#/$defs/documentPatterns",
                  "description": "Glob patterns selecting the files that define the values."
                },
                "pattern": {
                  "$ref": "#/$defs/nonEmptyString",
                  "description": "Regular expression matched against source text; its first capture group, or the whole match, is the value."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest", "pointer"],
              "properties": {
                "manifest": {
                  "$ref": "#/$defs/nonEmptyString",
                  "description": "JSON or YAML file holding the values."
                },
                "pointer": {
                  "description": "JSON pointer, or list of pointers, to an array of values or to a mapping whose keys are the values.",
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^/"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^/"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "documented": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "pattern": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "Regular expression an inline code span must match in full to count as a documented value."
            },
            "section": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "Heading text limiting the documented values to one section."
            }
          }
        }
      }
    },
    "directoryTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "fenceLabel"],
      "properties": {
        "documents": {
          "$ref": "#/$defs/documentPatterns"
        },
        "fenceLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$",
          "description": "Markdown fence metadata label identifying the tree blocks to compare."
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).*[^/]$",
          "description": "Repository-relative directory the tree describes, without a trailing slash."
        },
        "mode": {
          "enum": ["declared-exists", "exact"],
          "default": "declared-exists",
          "description": "declared-exists checks documented paths; exact also reports repository files the tree omits."
        },
        "ignore": {
          "$ref": "#/$defs/documentPatterns",
          "description": "Glob patterns excluded from the exact comparison."
        }
      }
    },
    "documentPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "mirror", "requireSame"],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mirror": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requireSame": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["headings", "commands", "codeBlocks"]
          }
        }
      }
    }
  }
}
